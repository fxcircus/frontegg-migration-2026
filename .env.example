# ================================================================
# FRONTEGG MIGRATION - ENVIRONMENT TEMPLATE
# ================================================================
# Copy this file to `.env` and fill in your credentials:
#
#   cp .env.example .env
#
# Notes:
# - Never commit your real .env file (it is git-ignored).
# - Use true/false (lowercase) for flags.
# - BASE_URL values must NOT end with a trailing slash.
#
# Regions:
# - EU: https://api.frontegg.com
# - US: https://api.us.frontegg.com
# - CA: https://api.ca.frontegg.com
# - AU: https://api.au.frontegg.com
# ================================================================

# -----------------------------
# Source account (FROM) - *_1
# -----------------------------
BASE_URL_1=https://api.frontegg.com
CLIENT_ID_1=__SOURCE_CLIENT_ID__
API_KEY_1=__SOURCE_API_KEY__

# -----------------------------
# Destination account (TO) - *_2
# -----------------------------
BASE_URL_2=https://api.us.frontegg.com
CLIENT_ID_2=__DESTINATION_CLIENT_ID__
API_KEY_2=__DESTINATION_API_KEY__

# -----------------------------
# Migration flags (main.py)
# Only needed for the manual flow; the orchestrator
# (orchestrator/run.py) sets these from profiles instead.
# -----------------------------
MIGRATE_TENANTS=false
MIGRATE_CATEGORIES=false
MIGRATE_PERMISSIONS=false
MIGRATE_ROLES=false
MIGRATE_APPLICATIONS=false
MIGRATE_SECURITY_RULES=false
MIGRATE_EMAIL_TEMPLATES=false
MIGRATE_EMAIL_SENDER=false
MIGRATE_PREHOOKS=false
MIGRATE_ALLOWED_ORIGINS=false
MIGRATE_REDIRECT_URIS=false
MIGRATE_JWT_SETTINGS=false
MIGRATE_SSO_CONFIGURATIONS=false
MIGRATE_ENTITLEMENTS=false
MIGRATE_API_ACCESS_CONTROL=false
MIGRATE_TENANT_HIERARCHY=false

# Environment auth/security policies: MFA policy (incl. forced MFA), MFA
# methods, lockout, password complexity/history, captcha, session
# configuration, and per-tenant policy overrides.
MIGRATE_AUTH_POLICIES=false

# Cutover delta (OPT-IN): create users that exist in the source but not the
# destination via Frontegg's data-migration endpoint. Passwords and MFA
# secrets CANNOT be carried this way - those users must reset their password
# or sign in via SSO/passwordless. Frontegg Support's delta migration remains
# the lossless route.
MIGRATE_MISSING_USERS=false

# Requires the users to already exist in the destination account
# (users themselves are migrated by Frontegg Support).
MIGRATE_USER_TENANT_ROLES=false

# User groups (definitions, group roles, group members) and the environment
# groups configuration. Members are matched by email, so migrate users first.
MIGRATE_GROUPS=false

# User attributes that are readable AND writable via the API: lock state,
# phone number, metadata, vendor metadata, external ID, name.
MIGRATE_USER_ATTRIBUTES=false

# Tenant API tokens follow TENANT_API_TOKENS_MODE (see "Tenant API token mode"
# below). User API tokens are always recreated with NEW clientId/secret values,
# written to USER_API_TOKENS_OUTPUT_CSV.
MIGRATE_TENANT_API_TOKENS=false
MIGRATE_USER_API_TOKENS=false

# -----------------------------
# Tenant API token mode (MIGRATE_TENANT_API_TOKENS)
# -----------------------------
# recreate (default) - every token is created anew in the destination with a NEW
#   clientId and secret. Works on every environment. The new credentials are
#   written to API_TOKENS_OUTPUT_CSV, and every consumer must switch to them.
#
# preserve - every token keeps its ORIGINAL clientId and secret, so consumers
#   keep the credentials they have (they only exchange them at the destination
#   environment's domain from now on). Requires Frontegg to enable the feature
#   flag `tenant-api-token-export-import-enabled` on BOTH environments - ask
#   Frontegg Support. If the flag is off the step stops without changing
#   anything; it never falls back to recreate.
#   - Different regions: the token is COPIED; the source keeps it until you
#     delete it there.
#   - Same region (BASE_URL_1 == BASE_URL_2): a clientId can exist only once per
#     region, so the token must be MOVED - deleted from the source, then imported.
#     Nothing is deleted unless TENANT_API_TOKENS_ALLOW_SOURCE_DELETE=true; until
#     then the run only reports which tokens need a move.
#   - Not covered: user API tokens and private_key_jwt public keys.
TENANT_API_TOKENS_MODE=recreate

# preserve mode, same region only. true = MOVE tokens: back each one up to
# TENANT_API_TOKENS_BACKUP_DIR, DELETE it from the SOURCE, import it into the
# destination, and re-import it into the source if that import fails. Each token
# works nowhere for a few seconds, and the source's tenantApiToken.deleted
# webhook fires. This is the ONLY write this tool ever makes to a source account.
TENANT_API_TOKENS_ALLOW_SOURCE_DELETE=false

# Where moved tokens are backed up (mode 0600, git-ignored). The backups hold
# secret hashes - delete them once the migration is confirmed.
TENANT_API_TOKENS_BACKUP_DIR=tenant_api_token_backups

# -----------------------------
# Optional tuning
# -----------------------------
# Bulk invite is limited to 5/min per environment on Launch and 10/min on
# Scale/Enterprise, so the default pace is one request per 12 seconds.
# Lower it to 6 on Scale/Enterprise to run twice as fast.
BULK_INVITE_MIN_INTERVAL_SECONDS=12

# Migrate tenant/user tokens whose expiry has already passed (off by default).
MIGRATE_EXPIRED_API_TOKENS=false

# Also migrate per-tenant policy overrides (MFA/lockout/session) - costs a few
# GET calls per source tenant (on by default).
AUTH_POLICIES_TENANT_OVERRIDES=true

# Allow MIGRATE_USER_ATTRIBUTES to UNLOCK destination users that are unlocked
# in the source (off by default - locked-only-in-destination is reported).
USER_ATTRIBUTES_UNLOCK=false

# Where MIGRATE_MISSING_USERS records the users it created.
MISSING_USERS_OUTPUT_CSV=migrated_missing_users.csv

# Where verify_migration.py writes its reconciliation report.
VERIFY_REPORT_PATH=verify_report.json

# Where the new API token credentials are written (mode 0600). The tenant CSV
# is only used in recreate mode.
API_TOKENS_OUTPUT_CSV=migrated_tenant_api_tokens.csv
USER_API_TOKENS_OUTPUT_CSV=migrated_user_api_tokens.csv

# -----------------------------
# Deletion flags (delete_account_data.py)
# DESTRUCTIVE - always deletes from the DESTINATION account (*_2).
# -----------------------------
DELETE_TENANTS=false
DELETE_USERS=false
DELETE_PERMISSIONS=false
DELETE_ROLES=false
DELETE_APPLICATIONS=false
DELETE_PREHOOKS=false
