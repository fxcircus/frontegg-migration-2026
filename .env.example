# ================================================================
# FRONTEGG MIGRATION - ENVIRONMENT TEMPLATE
# ================================================================
# Copy this file to `.env` and fill in your credentials:
#
#   cp .env.example .env
#
# Notes:
# - Never commit your real .env file (it is git-ignored).
# - Use true/false (lowercase) for flags.
# - BASE_URL values must NOT end with a trailing slash.
#
# Regions:
# - EU: https://api.frontegg.com
# - US: https://api.us.frontegg.com
# - CA: https://api.ca.frontegg.com
# - AU: https://api.au.frontegg.com
# ================================================================

# -----------------------------
# Source account (FROM) - *_1
# -----------------------------
BASE_URL_1=https://api.frontegg.com
CLIENT_ID_1=__SOURCE_CLIENT_ID__
API_KEY_1=__SOURCE_API_KEY__

# -----------------------------
# Destination account (TO) - *_2
# -----------------------------
BASE_URL_2=https://api.us.frontegg.com
CLIENT_ID_2=__DESTINATION_CLIENT_ID__
API_KEY_2=__DESTINATION_API_KEY__

# -----------------------------
# Migration flags (main.py)
# Only needed for the manual flow; the orchestrator
# (orchestrator/run.py) sets these from profiles instead.
# -----------------------------
MIGRATE_TENANTS=false
MIGRATE_CATEGORIES=false
MIGRATE_PERMISSIONS=false
MIGRATE_ROLES=false
MIGRATE_APPLICATIONS=false
MIGRATE_SECURITY_RULES=false
MIGRATE_EMAIL_TEMPLATES=false
MIGRATE_EMAIL_SENDER=false
MIGRATE_PREHOOKS=false
MIGRATE_ALLOWED_ORIGINS=false
MIGRATE_REDIRECT_URIS=false
MIGRATE_JWT_SETTINGS=false
MIGRATE_SSO_CONFIGURATIONS=false
MIGRATE_ENTITLEMENTS=false
MIGRATE_API_ACCESS_CONTROL=false

# -----------------------------
# Deletion flags (delete_account_data.py)
# DESTRUCTIVE - always deletes from the DESTINATION account (*_2).
# -----------------------------
DELETE_TENANTS=false
DELETE_USERS=false
DELETE_PERMISSIONS=false
DELETE_ROLES=false
DELETE_APPLICATIONS=false
DELETE_PREHOOKS=false
